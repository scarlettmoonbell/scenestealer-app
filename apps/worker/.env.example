# One-shot CLI mode (src/index.ts) — set these, then run
# `JOB_TYPE=analyze SOURCE_VIDEO_ID=<id> pnpm --filter @scenestealer/worker dev`.
JOB_TYPE=
SOURCE_VIDEO_ID=
DATABASE_URL=
RCLONE_RC_URL=
POSTIZ_API_URL=
POSTIZ_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Always-on HTTP mode (src/server.ts) — the deployed Fly app; see fly.toml.
PORT=8080
WORKER_SHARED_SECRET=
