# Committed, not gitignored — NEXT_PUBLIC_* is inlined into the client
# bundle at build time anyway, so there's nothing secret here, just a
# public API endpoint. Next.js loads this automatically for any
# production-mode build (`next build`, and critically the *internal*
# `vercel build` that `@cloudflare/next-on-pages` runs as part of
# `pnpm run pages:build` — that's a second, independent build, not a
# repackaging of whatever `pnpm run build` already produced).
#
# This exists specifically to kill a bug that recurred three times in
# one session: a shell env var passed to `pnpm run build` doesn't
# carry over to `pnpm run pages:build`'s internal rebuild, so without
# this file, .env.local's dev value (localhost:8787) silently wins for
# the actual deployed bundle even when the first build looked correct.
# See ROADMAP.md for the incident history.
NEXT_PUBLIC_API_URL=https://api.scenestealer.app
# Added 2026-09-17 during the OpenNext/Workers migration — the old
# Cloudflare Pages pipeline apparently sourced this from the Pages
# dashboard's own build-time env vars (a mechanism that doesn't exist
# for a Workers deploy), which this file never had a copy of. Its
# absence here made every single route 500 under Workers, since
# ClerkProvider has no publishableKey to inline into the client bundle
# without it. Non-secret by design (publishable key) — safe to commit.
# Confirmed as the value already live in production (the "loaded with
# development keys" Clerk console warning seen on the live site
# tonight matches this exact test-mode key).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZmlybS1iZWRidWctMzguY2xlcmsuYWNjb3VudHMuZGV2JA
